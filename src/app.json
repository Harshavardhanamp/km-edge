{
  "expo": {
    "name": "KM-Edge",
    "slug": "km-edge",
    "version": "0.1.0",
    "scheme": "kmedge",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF8F4"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kashyap.kmedge"
    },
    "android": {
      "package": "com.kashyap.kmedge",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-calendar",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "KM-Edge needs photo library access to attach images.",
          "cameraPermission": "KM-Edge needs camera access to scan documents and capture images."
        }
      ],
      [
        "expo-background-fetch",
        {
          "taskName": "km-edge-sync"
        }
      ]
    ]
  }
}
