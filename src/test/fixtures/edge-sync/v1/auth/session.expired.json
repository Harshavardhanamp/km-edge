{
  "name": "auth.session.expired",
  "request": {
    "method": "GET",
    "path": "/api/v1/edge/auth/me",
    "headers": {
      "X-Edge-Contract-Version": "1",
      "X-Edge-Device-Id": "01927c4a-0000-7000-8000-000000000001",
      "Authorization": "Bearer expired-token-001"
    }
  },
  "response": {
    "status": 401,
    "body": {
      "error": {
        "code": "EDGE_SESSION_EXPIRED"
      }
    }
  },
  "preconditions": [
    "token expired-token-001 is past absolute_seconds limit"
  ]
}
