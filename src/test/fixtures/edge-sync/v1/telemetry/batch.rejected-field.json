{
  "name": "telemetry.batch.rejected-field",
  "request": {
    "method": "POST",
    "path": "/api/v1/edge/telemetry",
    "headers": {
      "X-Edge-Contract-Version": "1",
      "X-Edge-Device-Id": "01927c4a-0000-7000-8000-000000000001",
      "Authorization": "Bearer test-token-001",
      "Content-Type": "application/json"
    },
    "body": {
      "events": [
        {
          "event_type": "RECORD_VIEWED",
          "edge_id": "01927c4a-0000-7000-8000-000000000002",
          "occurred_at": "2026-09-30T09:01:00Z",
          "unknown_field_xyz": "should be rejected"
        }
      ]
    }
  },
  "response": {
    "status": 422,
    "body": {
      "code": "EDGE_VALIDATION",
      "detail": "unknown field: unknown_field_xyz"
    }
  },
  "preconditions": ["server enforces strict field validation on telemetry events"]
}
